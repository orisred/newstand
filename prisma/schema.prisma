// App models for Cloudflare D1 (SQLite) via @prisma/adapter-d1.
// Migrations: prisma migrate diff -> migrations/NNNN_name.sql -> wrangler d1 migrations apply.
// migrate diff writes JSON defaults unquoted, which is invalid SQL: quote them by hand.

// prisma-client-js can't be bundled for Workers by Vite, so this generates into the app.
generator client {
  provider     = "prisma-client"
  output       = "../app/generated/prisma"
  runtime      = "workerd"
  moduleFormat = "esm"
  engineType   = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Shop {
  id                   String         @id @default(cuid())
  shopDomain           String         @unique
  releaseWordSingular  String         @default("issue")
  releaseWordPlural    String         @default("issues")
  allowedCountries     Json           @default("[\"US\"]")
  memberDiscountTag    String?        @default("active-subscriber")
  orderTiming          OrderTiming    @default(READY_TO_SHIP)
  emailsEnabled        Json           @default("{}")
  timezone             String?        // IANA name from Shopify, for showing and entering release dates
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  releases             Release[]
  plans                Plan[]
  subscriptions        Subscription[]
  events               Event[]
  emailSends           EmailSend[]
  memberTags           MemberTag[]
  importRuns           ImportRun[]
  importRows           ImportRow[]
}

enum ReleaseStatus {
  UNANNOUNCED // exists, no dates yet
  PREORDER    // announced; new subscribers switch to it (under PREORDER_SWITCHOVER)
  READY       // ready to ship; subscribers' orders created (under READY_TO_SHIP timing)
  SHIPPED
  CANCELLED
}

enum OrderTiming {
  READY_TO_SHIP   // create subscribers' $0 orders when the merchant marks the release ready (default)
  PREORDER_OPENS  // create them when the pre-order is announced
}

enum TriggerMode {
  MANUAL     // merchant presses "Announce pre-order" / "Ready to ship"
  SCHEDULED  // fires at preorderOpensAt / cutoffAt
}

model Release {
  id           String        @id @default(cuid())
  shopId       String
  shop         Shop          @relation(fields: [shopId], references: [id])
  number       Int
  title        String
  productGid   String?       // the Shopify variant on this release's $0 orders; null until chosen
  productTitle String?       // as picked, so pages need no Admin API call
  preorderOpensAt DateTime?  // when the pre-order opened; before that, only the planned date of a scheduled release
  cutoffAt     DateTime?     // when it went ready to ship; before that, only the planned date of a scheduled release
  shipAt       DateTime?
  triggerMode  TriggerMode   @default(MANUAL)
  quantity     Int?          // optional cap; null = no cap
  status       ReleaseStatus @default(UNANNOUNCED)
  runLeaseUntil DateTime?    // set while a run's slice works or sleeps, so one chain of jobs runs per release
  productCostCents  Int?     // what one copy costs; null = not recorded
  shippingCostCents Int?     // shipping, per order
  handlingCostCents Int?     // handling, per order
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deliveries   Delivery[]

  @@unique([shopId, number])
  @@index([shopId, cutoffAt])
}

enum BillingMode {
  PER_RELEASE     // first charge at sign-up; then charged when each release's order is created (follows Shop.orderTiming)
  PREPAID_BUNDLE  // releasesPerTerm paid upfront
}

enum RenewalRule {
  TERM_DATE_HOLD_IF_LATE // renew at term end, but wait for the last paid release's order (default)
  TERM_DATE              // renew at term end regardless
  ON_DEPLETION           // renew when paid releases run out
}

enum StartRule {
  PREORDER_SWITCHOVER       // latest release whose pre-order has opened; ships now if already released
  CURRENT_IF_BEFORE_CUTOFF  // that release if it isn't yet ready to ship; otherwise the next
  NEXT                      // the first release whose pre-order opens after sign-up
}

model Plan {
  id               String         @id @default(cuid())
  shopId           String
  shop             Shop           @relation(fields: [shopId], references: [id])
  name             String
  displayName      String         // shown to customers, e.g. "Yearly subscription"
  sellingPlanGid   String?        @unique
  sellingPlanGroupGid String?     @unique // one group per plan, holding this plan's one selling plan
  productGid       String?        // the product the plan is sold on; null until chosen
  productTitle     String?        // as picked, so pages need no Admin API call
  syncStatus       PlanSyncStatus @default(NOT_SYNCED)
  syncMessage      String?        // why it's ERROR or MISMATCH, in words for the merchant
  syncedAt         DateTime?
  syncRevision     Int            @default(0) // bumped by each change or retry; part of the sync job's ID
  syncLeaseUntil   DateTime?      // set while a sync runs, so two never run at once
  stockLevel       Int?           // lowest stock among variants that stop selling at 0; null = nothing can stop sign-ups
  stockCheckedAt   DateTime?
  billingMode      BillingMode    @default(PREPAID_BUNDLE)
  releasesPerTerm  Int            @default(1)
  termMonths       Int?           // e.g. 12 for a yearly bundle; null for per-release
  renewalRule      RenewalRule    @default(TERM_DATE_HOLD_IF_LATE)
  priceCents       Int
  currency         String         @default("USD")
  autoRenew        Boolean        @default(true)
  startRule        StartRule      @default(PREORDER_SWITCHOVER)
  giftable         Boolean        @default(false)
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  subscriptions    Subscription[]
  priceChanges     PriceChange[]

  @@index([shopId, createdAt])
}

enum PlanSyncStatus {
  NOT_SYNCED // new, or changed since the last sync
  SYNCING
  SYNCED     // Shopify was read back and matches
  MISMATCH   // read back and differs from this record
  ERROR      // Shopify refused or didn't answer
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED // auto-renew off; remaining paid releases still ship
  ENDED
}

enum SubscriptionSource {
  NEW
  GIFT
  IMPORTED
}

model Subscription {
  id                 String             @id @default(cuid())
  shopId             String
  shop               Shop               @relation(fields: [shopId], references: [id])
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  contractGid        String?            @unique
  customerGid        String
  status             SubscriptionStatus @default(ACTIVE)
  source             SubscriptionSource @default(NEW)
  quantity           Int                @default(1) // copies of each release; the contract bills for them all
  releasesRemaining  Int                // paid releases whose order hasn't been created. See DECISIONS.md
  firstReleaseNumber Int                @default(1) // the lowest-numbered release this subscriber can receive; a renewal at 0 moves it on
  termEndsAt         DateTime?          // bundle renewal date before any late-release hold
  nextReleaseId      String?            // unused: a PENDING Delivery says what's next
  lockedPriceCents   Int?
  giftBuyerGid       String?
  giftMessage        String?
  pausedReason       String?            // FAILED_PAYMENT or CHARGEBACK
  paymentProblemSince DateTime?         // from the first failed try or chargeback until it's resolved. See "Reach-back" in DECISIONS.md
  signupCents        Int?               // the sign-up payment order's subtotal; null until read. See "Dashboard" in DECISIONS.md
  importedBalance    Int?               // IMPORTED: paid releases it arrived with, paid outside the app's records
  noCardSince        DateTime?          // IMPORTED: its contract has no card, so its next charge will fail. See "Migration import"
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deliveries         Delivery[]
  billingAttempts    BillingAttempt[]
  events             Event[]
  emailSends         EmailSend[]

  @@index([shopId, status])
  @@index([shopId, paymentProblemSince])
  @@index([customerGid])
}

enum DeliveryStatus {
  PENDING      // assigned, order not yet created
  ORDERED      // $0 order created at cutoff
  HELD         // the release a failed charge was for, or a bundle's while a payment fails, or any under a chargeback
  FULFILLED
  CANCELLED
}

model Delivery {
  id              String         @id @default(cuid())
  subscriptionId  String
  subscription    Subscription   @relation(fields: [subscriptionId], references: [id])
  releaseId       String
  release         Release        @relation(fields: [releaseId], references: [id])
  orderGid        String?        @unique
  orderName       String?        // such as #1017, for the run's CSV; not personal data
  status          DeliveryStatus @default(PENDING)
  addressConfirmedAt DateTime?   // from the pre-order email's main CTA
  orderLeaseUntil DateTime?      // set while an order is being created, so two never run at once
  orderError      String?        // why Shopify refused the order, in words for the merchant
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([subscriptionId, releaseId])
  @@index([releaseId, status])
}

enum BillingResult {
  PENDING
  SUCCEEDED
  FAILED
}

model BillingAttempt {
  id               String        @id @default(cuid())
  subscriptionId   String
  subscription     Subscription  @relation(fields: [subscriptionId], references: [id])
  chargeFor        String        // the release ID, or term-<ms> for a bundle renewal. See DECISIONS.md
  idempotencyKey   String        @unique // subscriptionId:chargeFor:attempt
  attempt          Int
  shopifyAttemptGid String?      @unique
  orderGid         String?       // the billing order, once it has succeeded
  amountCents      Int?          // that order's subtotal; null until read
  result           BillingResult @default(PENDING)
  errorCode        String?
  nextRetryAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([subscriptionId, chargeFor])
  @@index([chargeFor, result])
  @@index([result, createdAt])
  @@index([nextRetryAt])
}

enum PriceChangePolicy {
  KEEP_OLD_PRICE
  APPLY_AT_RENEWAL
}

model PriceChange {
  id             String            @id @default(cuid())
  planId         String
  plan           Plan              @relation(fields: [planId], references: [id])
  newPriceCents  Int
  policy         PriceChangePolicy
  effectiveAt    DateTime
  noticeSentAt   DateTime?
  createdAt      DateTime          @default(now())
}

model Event {
  id              String        @id @default(cuid())
  shopId          String
  shop            Shop          @relation(fields: [shopId], references: [id])
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  type            String
  payload         Json
  sentToFlowAt    DateTime?
  createdAt       DateTime      @default(now())

  @@index([shopId, type, createdAt])
  @@index([subscriptionId])
}

enum EmailStatus {
  PENDING  // queued, or put back after a limit or a Cloudflare hiccup
  SENDING  // claimed; a lapsed claim is UNSURE, never sent again by itself
  SENT
  SKIPPED  // switched off, the subscriber changed state, or there is nobody to send to
  FAILED   // refused for good; `reason` is Cloudflare's error code
  UNSURE   // claimed and never settled: it may or may not have been sent
}

// One row per email per subscription per subject, written before sending: what makes an email once-only.
// `id` is kind:subscriptionId:subject, with the release, event or price change as the subject.
// No names, addresses or message text are kept.
model EmailSend {
  id             String       @id
  shopId         String
  shop           Shop         @relation(fields: [shopId], references: [id])
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  kind           String       // an EmailKey, or priceChange
  subject        String
  status         EmailStatus  @default(PENDING)
  attempts       Int          @default(0)
  leaseUntil     DateTime?
  reason         String?      // why it was skipped or failed: a code, never a message
  messageId      String?
  sentAt         DateTime?
  addressConfirmedAt DateTime? // pre-order email only: the CTA, before the Delivery exists. See DECISIONS.md
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([shopId, status])
  @@index([subscriptionId])
}

// The member discount tag the app last put on a customer in a shop, so a tick can tell who has drifted.
model MemberTag {
  id          String   @id // shopId:customerGid
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id])
  customerGid String
  tag         String?  // null = the app has put no tag on them
  updatedAt   DateTime @updatedAt

  @@index([shopId])
}

enum ImportRunStatus {
  COLLECTING // the browser is sending contacts
  READING    // the dry run is reading order history
  READ       // the report is ready
  IMPORTING  // the real run is creating contracts
  DONE
}

// One upload of a contacts export. `settings` is the plan mapping and past issues, never contact data.
model ImportRun {
  id         String          @id
  shopId     String
  shop       Shop            @relation(fields: [shopId], references: [id])
  status     ImportRunStatus @default(COLLECTING)
  settings   Json
  readAt     DateTime?       // when the dry run finished: its term dates are as of then
  importedAt DateTime?       // when the real run started
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([shopId, createdAt])
}

enum ImportRowState {
  TO_READ   // a contact whose orders haven't been read
  READ      // in the report
  QUEUED    // the real run will create it, after reading the customer again
  CREATING  // leased while a contract is created; a lapsed lease is taken up again
  DONE      // has its contract and Subscription
  SKIPPED   // the real run's fresh read said not to import it
  FAILED    // Shopify refused; `error` says why
}

// A line of the import report. Holds Shopify IDs, numbers, dates and a country code, and no names,
// addresses or emails. `key` is customer:plan:first order, so a later run finds the same row.
model ImportRow {
  id               String         @id
  shopId           String
  shop             Shop           @relation(fields: [shopId], references: [id])
  key              String         // also the marker on the contract in Shopify
  runId            String         // the run that last read it
  contactNumber    Int?           // which data line of the merchant's export
  customerGid      String?
  contactCancelled Boolean        @default(false)
  planId           String?
  state            ImportRowState @default(TO_READ)
  category         String?        // see CATEGORY_TEXT in app/routes/app.import.tsx
  flags            Json           @default("[]")
  facts            Json           @default("{}")
  leaseUntil       DateTime?
  attempts         Int            @default(0)
  contractGid      String?
  subscriptionId   String?
  error            String?        // Shopify's code and field, never a message that could quote the customer
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([shopId, key])
  @@index([runId, state])
  @@index([runId, category])
  @@index([shopId, customerGid])
}

enum JobRunStatus {
  CLAIMED // running, or failed and waiting for its retry; a lapsed lease can be claimed again
  DONE
  DEAD    // used up its retries and reached the dead-letter queue; never runs again by itself
}

// One row per job idempotency key: what makes a job run once when its message arrives twice.
model JobRun {
  key            String       @id // Job.id, such as subscriptionId:releaseId:attempt
  type           String
  shop           String?
  status         JobRunStatus @default(CLAIMED)
  owner          String?      // which run holds the lease
  leaseExpiresAt DateTime?
  runs           Int          @default(1)
  lastError      String?      // error name only, never a message
  body           String?      // the message, kept when it goes DEAD so it can be sent again
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// Shopify offline tokens. Read and written only by app/session-storage.server.ts. See DECISIONS.md.
model OfflineSession {
  id   String @id // offline_{shop}
  data String // the session as JSON
}
