{%- comment -%}
  Lists this app's plans for the product and submits the chosen one as `selling_plan` with the
  theme's product form. The radios join the form through the `form` attribute, which is enough for
  add to cart without JavaScript. The script puts the choice in a hidden input inside the form
  instead, because Buy it now only reads it from there. Most themes name the form
  `product-form-<section id>`; the "Product form ID" setting covers one that doesn't.

  Only plans with this app's `app_id` are shown, so another app's plans never appear here.
  The app makes a product with plans require one, so there is no one-time option: the first plan
  is chosen by default.

  A giftable plan (the app lists them in `app.metafields.release_subscriptions.giftable_plans`) also
  offers "This is a gift": the recipient's email, name and a message, sent as line item properties
  that the app reads from the subscription contract. They're disabled, so not sent, unless a
  giftable plan is chosen and the box is ticked, and then the recipient's email is required. Without
  JavaScript the gift option never shows.
{%- endcomment -%}
{%- liquid
  assign form_id = block.settings.form_id
  if form_id == blank
    assign form_id = 'product-form-' | append: section.id
  endif
  assign legend = block.settings.heading
  assign legend_class = ''
  if legend == blank
    assign legend = 'plan_picker.legend' | t
    assign legend_class = ' plan-picker__legend--hidden'
  endif
  assign has_plans = false
  assign gift_plans = ',' | append: app.metafields.release_subscriptions.giftable_plans.value | append: ','
  for group in product.selling_plan_groups
    if group.app_id == 'release-subscriptions'
      assign has_plans = true
    endif
  endfor
-%}
{%- if has_plans -%}
  {{ 'plan-picker.css' | asset_url | stylesheet_tag }}
  <fieldset class="plan-picker" {{ block.shopify_attributes }}>
    <legend class="plan-picker__legend{{ legend_class }}">{{ legend | escape }}</legend>
    {%- render 'plan-options', product: product, form_id: form_id, gift_plans: gift_plans -%}
    <script src="{{ 'plan-picker.js' | asset_url }}" defer></script>
    {%- if block.settings.terms != blank -%}
      <p class="plan-picker__terms">{{ block.settings.terms | escape }}</p>
    {%- endif -%}
  </fieldset>
{%- elsif request.design_mode -%}
  <p class="plan-picker__terms" {{ block.shopify_attributes }}>
    This product has no plans from Release Subscriptions, so the plan picker is hidden. Add a plan to this product in the app.
  </p>
{%- endif -%}

{% schema %}
{
  "name": "Plan picker",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose a plan",
      "info": "Leave empty to hide it. Screen readers still announce a label."
    },
    {
      "type": "textarea",
      "id": "terms",
      "label": "Subscription terms",
      "info": "Shown under the plans: how often and when customers are billed, that it renews automatically, and how to cancel. Leave empty to show nothing."
    },
    {
      "type": "text",
      "id": "form_id",
      "label": "Product form ID",
      "info": "Leave empty unless your theme's product form isn't named product-form-<section ID>."
    }
  ]
}
{% endschema %}
